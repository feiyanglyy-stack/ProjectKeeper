{
  "name": "projectkeeper",
  "version": "0.1.0",
  "description": "A resident agent that reads a software project as it is — documents, git history, code and agent sessions — and keeps a browsable picture of what was planned, decided and done. Local-first; bring your own model key.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "project-context",
    "context-engineering",
    "project-management",
    "developer-tools",
    "claude-code",
    "codex",
    "local-first",
    "project-graph",
    "decision-records"
  ],
  "homepage": "https://github.com/feiyanglyy-stack/ProjectKeeper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiyanglyy-stack/ProjectKeeper.git"
  },
  "bugs": {
    "url": "https://github.com/feiyanglyy-stack/ProjectKeeper/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "projectkeeper": "bin/pk.mjs",
    "pk": "bin/pk.mjs"
  },
  "scripts": {
    "postinstall": "node bin/postinstall.mjs",
    "start": "node src/cli.ts serve",
    "demo": "node scripts/demo.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "cytoscape": "3.34.3",
    "cytoscape-dagre": "4.0.1",
    "dagre": "0.8.5",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.13.5"
  }
}
